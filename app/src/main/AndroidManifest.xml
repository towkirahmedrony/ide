<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The model gateway talks to the configured model endpoint, the Model
         Runner browser loads the notebook the runtime lives in, and OAuth
         authorization pages are opened in the user's own browser. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- "All files access" (special, granted by the user in Android Settings) is what lets the
         PRoot guest read and write a project folder that was picked through the Storage Access
         Framework directly at its original path — bind-mounted in place at /workspace, with no
         copy into app storage. The bind falls back to the guest home until it is granted. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AgentX">

        <!--
            singleTask so a redirect that arrives while the app is running reaches
            onNewIntent instead of opening a second task.

            The OAuth redirect is registered twice: a private app scheme, which
            needs no domain, and an https deep link for deployments that own the
            callback domain. Only the redirect URI registered with the provider is
            used, so both stay inert until one of them is configured.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.AgentX">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="${oauthRedirectHost}"
                    android:scheme="${oauthRedirectScheme}" />
            </intent-filter>

            <!--
                No path prefix: each service has its own callback path
                (github, supabase, mcp, ...), so restricting the filter to one
                path would drop every redirect except that one. The host is a
                domain the owner dedicates to this app's callbacks.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="${oauthHttpsHost}"
                    android:scheme="https" />
            </intent-filter>
        </activity>

    </application>

</manifest>
