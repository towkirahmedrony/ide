# Gradle
.gradle/
build/
.kotlin/
!gradle/wrapper/gradle-wrapper.jar

# Local machine SDK path (never commit)
local.properties

# IDE
.idea/
*.iml
.vscode/

# OS
.DS_Store

# Build outputs
*.apk
*.aab
captures/
.cxx/
.externalNativeBuild/

# Android signing keys
*.jks
*.keystore

# Native developer runtime (PRoot + loader + talloc + android-shmem). Built from pinned
# upstream sources by .github/workflows/android-build.yml and dropped into jniLibs by
# vendor-native.sh; never committed, because a rebuildable binary does not belong in the tree.
ubuntu-runtime/src/main/jniLibs/
tools/ubuntu-runtime/out/
tools/ubuntu-runtime/build/

# Local integration patch produced for offline hand-off; not part of the source tree.
termux-terminal-integration.patch
ci-workflow-changes.patch

# Termux bootstrap build: the upstream checkout, the built archives and the verification
# output are local artifacts. Only tools/termux-bootstrap and the workflow are source.
termux-packages/
tools/termux-bootstrap/dist/
tools/termux-bootstrap/build/

# Python bytecode from tools/termux-bootstrap
__pycache__/
*.pyc
