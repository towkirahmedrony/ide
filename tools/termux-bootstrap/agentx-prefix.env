# Single source of truth for the AgentX Termux bootstrap build.
#
# Sourced by the scripts in this directory and by
# .github/workflows/build-termux-bootstrap.yml. Nothing here is exported
# into the builder container except where a script explicitly says so.
#
# Every value below is the AgentX counterpart of an upstream termux-packages
# variable. Upstream derivation (verified, see README.md "How the prefix is
# defined"):
#
#   TERMUX_APP__DATA_DIR = /data/data/$TERMUX_APP__PACKAGE_NAME
#   TERMUX__ROOTFS       = $TERMUX_APP__DATA_DIR/$TERMUX__ROOTFS_SUBDIR   (files)
#   TERMUX__PREFIX       = $TERMUX__ROOTFS/$TERMUX__PREFIX_SUBDIR         (usr)
#   TERMUX__HOME         = $TERMUX__ROOTFS/$TERMUX__HOME_SUBDIR           (home)
#
# Only TERMUX_APP__PACKAGE_NAME is patched upstream; everything else derives
# from it inside scripts/properties.sh.

# --- AgentX identity -----------------------------------------------------------------

AGENTX_PACKAGE_NAME="com.agentx.app"

# --- Derived paths (must match what upstream derives after the patch) ----------------

AGENTX_APP_DATA_DIR="/data/data/com.agentx.app"
AGENTX_ROOTFS="/data/data/com.agentx.app/files"
AGENTX_PREFIX="/data/data/com.agentx.app/files/usr"
AGENTX_HOME="/data/data/com.agentx.app/files/home"

# Matches TermuxBootstrapArchive.INSTALL_MARKER in :termux-runtime.
AGENTX_INSTALL_MARKER="etc/termux/agentx-bootstrap.ok"

# Matches TermuxBootstrapArchive.SYMLINK_MANIFEST.
AGENTX_SYMLINK_MANIFEST="SYMLINKS.txt"

# --- Pinned upstream -----------------------------------------------------------------

# termux/termux-packages, commit 2fdb0c07f3fec34adf24c8af515c852fc51f4c9b
# committed 2026-09-29T03:40:09Z ("bump(x11/qbittorrent): 5.2.4").
TERMUX_PACKAGES_COMMIT="2fdb0c07f3fec34adf24c8af515c852fc51f4c9b"
TERMUX_PACKAGES_URL="https://github.com/termux/termux-packages.git"

# Recorded in TermuxBootstrapCatalog.Entry.sourceRevision and in each artifact's
# manifest.json. Deliberately not "unbuilt": these constants describe the build
# this repository is set up to produce. The catalog's sourceRevision for an ABI
# stays SOURCE_REVISION_UNBUILT until a real artifact for that ABI exists.
AGENTX_SOURCE_REVISION="termux-packages@${TERMUX_PACKAGES_COMMIT}+agentx"

# --- ABI mapping ---------------------------------------------------------------------

# Android ABI -> Termux architecture, and the architectures the workflow matrix
# and the catalog must cover.
AGENTX_ANDROID_ABIS="arm64-v8a armeabi-v7a x86 x86_64"
AGENTX_TERMUX_ARCHES="aarch64 arm i686 x86_64"

# Translate an Android ABI to a Termux architecture. Prints nothing and fails
# for an unknown ABI, so a typo cannot silently produce the wrong artifact.
agentx_termux_arch_for_abi() {
    case "${1:-}" in
        arm64-v8a)   echo aarch64 ;;
        armeabi-v7a) echo arm ;;
        x86)         echo i686 ;;
        x86_64)      echo x86_64 ;;
        *)           return 1 ;;
    esac
}

# Translate a Termux architecture to an Android ABI.
agentx_android_abi_for_arch() {
    case "${1:-}" in
        aarch64) echo arm64-v8a ;;
        arm)     echo armeabi-v7a ;;
        i686)    echo x86 ;;
        x86_64)  echo x86_64 ;;
        *)       return 1 ;;
    esac
}

# The 64-bit Termux architectures. Decides which emulator/ld path is expected.
agentx_is_64bit_arch() {
    case "${1:-}" in
        aarch64|x86_64) return 0 ;;
        *)              return 1 ;;
    esac
}

# --- Artifact naming -----------------------------------------------------------------

agentx_asset_name_for_arch() {
    echo "bootstrap-${1}.zip"
}
